{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["shared/*"]
    }
  },

  // One project rather than composite references: the frontend, the shared
  // domain code and the import script all typecheck together, which is what you
  // want when they share the same rules.
  //
  // `amplify/shared` is included so `npm run typecheck` covers the backend
  // helpers. Leaving it out once let a type error reach CI: the local check went
  // green while the Amplify build failed on a file it had never looked at.
  //
  // Only the two Lambda *handlers* stay out, because they import `$amplify/env/*`
  // which Amplify generates at deploy time. `npm run typecheck:backend` covers
  // those once a sandbox has run; the Amplify build always does.
  "include": [
    "src",
    "shared",
    "scripts",
    "amplify/data",
    "amplify/shared",
    "amplify/functions/*/resource.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
