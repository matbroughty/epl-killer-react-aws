{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["shared/*"]
    }
  },

  // One project rather than composite references: the frontend, the shared
  // domain code and the import script all typecheck together, which is what you
  // want when they share the same rules.
  //
  // `amplify/data` is here because the frontend imports the `Schema` type from
  // it. The Lambda handlers and their helpers are not: they import
  // `$amplify/env/*`, which Amplify generates at deploy time, and `ampx`
  // typechecks and bundles them (see `npm run typecheck:backend`).
  "include": [
    "src",
    "shared",
    "scripts",
    "amplify/data",
    "amplify/functions/*/resource.ts",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
