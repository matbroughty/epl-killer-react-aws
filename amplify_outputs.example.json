{
  "_comment": [
    "This is a placeholder so `npm run build` and `npm run typecheck` work in a fresh clone.",
    "The real amplify_outputs.json is generated by the backend deployment and is gitignored:",
    "  - locally:  npx ampx sandbox",
    "  - in CI:    npx ampx pipeline-deploy (see amplify.yml)",
    "Copy this file to amplify_outputs.json if you only want to compile the frontend."
  ],
  "version": "1.3",
  "auth": {
    "aws_region": "eu-west-2",
    "user_pool_id": "eu-west-2_PLACEHOLDER",
    "user_pool_client_id": "placeholder",
    "identity_pool_id": "eu-west-2:00000000-0000-0000-0000-000000000000",
    "username_attributes": ["email"],
    "standard_required_attributes": ["email"],
    "user_verification_types": ["email"],
    "unauthenticated_identities_enabled": true,
    "password_policy": {
      "min_length": 10,
      "require_lowercase": true,
      "require_numbers": true,
      "require_symbols": false,
      "require_uppercase": false
    },
    "groups": [{ "ADMIN": { "precedence": 0 } }]
  },
  "data": {
    "aws_region": "eu-west-2",
    "url": "https://placeholder.appsync-api.eu-west-2.amazonaws.com/graphql",
    "default_authorization_type": "AMAZON_COGNITO_USER_POOLS",
    "authorization_types": ["AWS_IAM"]
  }
}
